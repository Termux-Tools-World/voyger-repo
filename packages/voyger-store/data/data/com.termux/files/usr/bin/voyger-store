#!/data/data/com.termux/files/usr/bin/bash

# ==========================================
# 💀 VOYGER X: ULTIMATE PREMIUM STORE 💀
# ==========================================

RED='\033[1;31m'
GREEN='\033[1;32m'
CYAN='\033[1;36m'
YELLOW='\033[1;33m'
NC='\033[0m'

# fzf এবং curl চেক ও ইনস্টল
if ! command -v fzf &> /dev/null; then
    echo -e "${CYAN}[*] Installing required components (fzf)...${NC}"
    pkg install fzf -y > /dev/null 2>&1
fi

# ড্যাশবোর্ড লোগো
show_banner() {
    clear
    echo -e "${RED}"
    cat << "EOF"
██╗   ██╗ ██████╗ ██╗   ██╗ ██████╗ ███████╗██████╗     ██╗  ██╗
██║   ██║██╔═══██╗╚██╗ ██╔╝██╔════╝ ██╔════╝██╔══██╗    ╚██╗██╔╝
██║   ██║██║   ██║ ╚████╔╝ ██║  ███╗█████╗  ██████╔╝     ╚███╔╝ 
╚██╗ ██╔╝██║   ██║  ╚██╔╝  ██║   ██║██╔══╝  ██╔══██╗     ██╔██╗ 
 ╚████╔╝ ╚██████╔╝   ██║   ╚██████╔╝███████╗██║  ██║    ██╔╝ ██╗
  ╚═══╝   ╚═════╝    ╚═╝    ╚═════╝ ╚══════╝╚═╝  ╚═╝    ╚═╝  ╚═╝
EOF
    echo -e "${NC}"
}

# গিটহাব থেকে টুলের লিস্ট ফেচ করা
fetch_tools() {
    show_banner
    echo -e "${CYAN} [*] Syncing with Voyger Servers...${NC}"
    TOOLS_RAW=$(curl -s "https://raw.githubusercontent.com/Termux-Tools-World/voyger-repo/repo-dist/Packages")
    
    if [ -z "$TOOLS_RAW" ]; then
        echo -e "${RED} [!] Failed to connect. Check your internet.${NC}"
        exit 1
    fi

    # Packages ফাইল থেকে টুলের নাম আর ডেসক্রিপশন আলাদা করা
    TOOL_LIST=$(echo "$TOOLS_RAW" | awk '/^Package:/{pkg=$2} /^Description:/{desc=substr($0, index($0,$2)); print pkg " - " desc}')
}

# মেইন ফাংশন
main() {
    fetch_tools
    
    # fzf দিয়ে ইন্টারঅ্যাকটিভ সার্চ
    echo -e "${GREEN} [*] Type to search for a tool (Use Arrow Keys to select, Enter to install):${NC}"
    echo ""
    
    SELECTED=$(echo "$TOOL_LIST" | fzf --height 60% --reverse --border --prompt="🔍 Search Tool: " --header="💀 VOYGER X PREMIUM STORE 💀")
    
    # যদি ইউজার কিছু সিলেক্ট করে
    if [ -n "$SELECTED" ]; then
        # শুধু প্যাকেজের নামটা বের করা (যেমন: voyger-matrix)
        TOOL_NAME=$(echo "$SELECTED" | awk '{print $1}')
        
        clear
        echo -e "${CYAN} [+] Selected: $TOOL_NAME${NC}"
        echo -e "${YELLOW} [*] Installing... Please wait.${NC}"
        
        # pkg install রান করা
        pkg install "$TOOL_NAME" -y
        
        echo ""
        echo -e "${GREEN} ✅ $TOOL_NAME installed successfully!${NC}"
        echo -e "${CYAN} Run it by typing: $TOOL_NAME${NC}"
        echo ""
        read -p "Press Enter to return to store..." dummy
        
        # আবার মেইন মেনুতে ফেরা
        main
    else
        echo -e "${RED} Exiting Voyger Store...${NC}"
        exit 0
    fi
}

# রান
main
